# Copy to .env and adjust. Never commit .env.

# Image used by compose files
IMAGE=docker.io/dwightmulcahy/brewcrm:latest

# Host port mapped to container port 8080
HOST_PORT=8080
TZ=America/Costa_Rica

# QNAP (compose.qnap.yaml). Must be writable by uid 1000: chown -R 1000:100 <dir>
QNAP_DATA_DIR=/share/Container/brewcrm/data

# Public URL of the app as users reach it (e.g. through hotpot). Used for the Gmail OAuth redirect.
APP_URL=https://crm.example.com
CURRENCY=CRC

# Admin login (email is lowercased). Works on the CRM sign-in page and the admin dashboard at /_/.
# 12+ characters with a letter and a number, plus a symbol unless 16+ characters; must not
# contain the email name. The CRM password is re-applied only when this value changes, so a
# password changed in BrewCRM survives restarts.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-2-a-long-password

# Google Places API (New) - lead search
GOOGLE_PLACES_API_KEY=
PLACES_REGION=CR
PLACES_LANGUAGE=es
# Monthly caps kept under Google's free allowance (5,000 Text Search Pro / 1,000 Enterprise detail calls)
PLACES_SEARCH_MONTHLY_LIMIT=4500
PLACES_DETAILS_MONTHLY_LIMIT=900

# Gmail (OAuth client, type "Web application")
# Authorized redirect URI: ${APP_URL}/api/crm/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_LOOKBACK_DAYS=30

# Loyverse POS (Back Office > Access tokens > + Add access token)
LOYVERSE_ACCESS_TOKEN=
# How far back to import receipts when an account is first linked
LOYVERSE_LOOKBACK_DAYS=365

# Deals in first_order/recurring move to dormant after this many days without an order
DORMANT_DAYS=45

# Number of prewarmed JS hook runtimes (lower = less RAM)
PB_HOOKS_POOL=4

# One JSON access-log line per request on stdout (for logwatch). 0 = off
ACCESS_LOG=1

# App name in emails
APP_NAME=BrewCRM

# Outgoing mail for "Forgot password?" reset emails (leave SMTP_HOST empty to configure in /_/ instead).
# Gmail: smtp.gmail.com, port 587, your address, and an App Password (Google Account > Security).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# true = implicit TLS (port 465); false = STARTTLS (port 587)
SMTP_TLS=false
SMTP_SENDER_ADDRESS=
SMTP_SENDER_NAME=BrewCRM

# Rate limits per client IP (10 sign-ins/min, 3 reset emails/5 min). 0 = off.
# Behind hotpot, set Trusted proxy > X-Real-IP in /_/ so users don't share one limit.
RATE_LIMITS=1
