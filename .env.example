# Copy to .env and adjust. Never commit .env.

# Image used by compose files
IMAGE=docker.io/dwightmulcahy/brewcrm:latest

# Host port mapped to container port 8080
HOST_PORT=8080
TZ=America/Costa_Rica

# QNAP (compose.qnap.yaml). Must be writable by uid 1000: chown -R 1000:100 <dir>
QNAP_DATA_DIR=/share/Container/brewcrm/data

# Public URL of the app (Cloudflare Tunnel hostname). Used for the Gmail OAuth redirect.
APP_URL=https://crm.example.com
CURRENCY=CRC

# Admin login for /_/ (created/updated at every start). Use a long unique password.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-to-a-long-password

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# Google Places API (New) - lead search
GOOGLE_PLACES_API_KEY=
PLACES_REGION=CR
PLACES_LANGUAGE=es
# Monthly caps kept under Google's free allowance (5,000 Text Search Pro / 1,000 Enterprise detail calls)
PLACES_SEARCH_MONTHLY_LIMIT=4500
PLACES_DETAILS_MONTHLY_LIMIT=900

# Gmail (OAuth client, type "Web application")
# Authorized redirect URI: ${APP_URL}/api/crm/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_LOOKBACK_DAYS=30

# Loyverse POS (Back Office > Access tokens > + Add access token)
LOYVERSE_ACCESS_TOKEN=
# How far back to import receipts when an account is first linked
LOYVERSE_LOOKBACK_DAYS=365

# Deals in first_order/recurring move to dormant after this many days without an order
DORMANT_DAYS=45

# Number of prewarmed JS hook runtimes (lower = less RAM)
PB_HOOKS_POOL=4
